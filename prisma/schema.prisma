generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  posts     BlogPost[]

  @@index([slug])
}

model Tag {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  posts     BlogPost[] @relation("BlogPostToTag")

  @@index([slug])
}

model Series {
  id          String     @id @default(cuid())
  title       String
  description String?
  slug        String     @unique
  coverImage  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  authorId    String
  author      User       @relation(fields: [authorId], references: [id])
  posts       BlogPost[]

  @@index([slug])
}

model BlogPost {
  id          String     @id @default(cuid())
  title       String
  content     String
  published   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  authorId    String
  categoryId  String
  slug        String     @unique
  coverImage  String?
  seriesId    String?
  seriesOrder Int?
  viewCount   Int        @default(0)
  author      User       @relation(fields: [authorId], references: [id])
  category    Category   @relation(fields: [categoryId], references: [id])
  series      Series?    @relation(fields: [seriesId], references: [id])
  tags        Tag[]      @relation("BlogPostToTag")
  views       PostView[]

  @@index([title])
  @@index([slug])
  @@index([seriesId])
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  isAdmin       Boolean    @default(false)
  accounts      Account[]
  blogPosts     BlogPost[]
  series        Series[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PostView {
  id          String   @id @default(cuid())
  postId      String
  fingerprint String
  createdAt   DateTime @default(now())
  post        BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Composite index for efficient lookups: find views by post + fingerprint
  @@index([postId, fingerprint])
  // Index for cleanup queries (delete old views)
  @@index([createdAt])
  // Index for postId alone for counting/aggregations
  @@index([postId])
}
