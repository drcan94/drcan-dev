# ----------------------------------------------------------------------------
# TEMEL ORTAM DEĞİŞKENLERİ
# Bu dosyayı ".env" olarak kopyalayın ve değerleri kendi bilgilerinizle doldurun
# ----------------------------------------------------------------------------

# Next Auth
# Güvenlik anahtarı oluşturmak için "npx auth secret" veya "openssl rand -base64 32" komutunu kullanın
AUTH_SECRET="secret_key_buraya_gelecek"

# Google OAuth Entegrasyonu
# Google Cloud Console'da OAuth kimlik bilgilerini oluşturun
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# PostgreSQL Veritabanı Bağlantısı
# Neon.tech, Railway veya herhangi bir PostgreSQL veritabanı hizmeti kullanabilirsiniz
# Format: postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL="postgresql://username:password@host:port/database?sslmode=require"

# Dosya Yükleme Servisi (UploadThing)
# https://uploadthing.com adresinden bir hesap oluşturun ve API anahtarınızı alın
UPLOADTHING_TOKEN="your_uploadthing_api_key"

# Node Ortamı
# Geliştirme ortamı için "development", üretim ortamı için "production"
NODE_ENV="development" 